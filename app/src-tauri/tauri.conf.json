{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "PR1ME Studio",
	"version": "0.2.1",
	"identifier": "labs.pr1me.studio",
	"build": {
		"beforeDevCommand": "",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "npm run build:web",
		"frontendDist": "../build"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "PR1ME Studio",
				"label": "main",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 600,
				"decorations": false,
				"resizable": true,
				"fullscreen": false,
				"center": true,
				"transparent": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "DeveloperTool",
		"shortDescription": "PR1ME Studio desktop client",
		"longDescription": "PR1ME Studio — the desktop client for the pr1me short-form production OS."
	}
}